# Meta Model API key from https://dev.meta.ai/ (format: LLM|<id>|<secret>).
# Leave empty to run with mock data.
MODEL_API_KEY=

# Optional overrides
# META_BASE_URL=https://api.meta.ai/v1
# META_TEXT_MODEL=muse-spark-1.3
# META_IMAGE_MODEL=muse-image-1.0
# MOCK_AI=1

# Optional: self-hosted SAM 3D Objects server (needs a 32 GB+ NVIDIA GPU).
# Contract: POST { image: dataUrl } -> { glb: base64 }
# SAM3D_ENDPOINT_URL=
# SAM3D_API_KEY=
